{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Storage": {
    "ScansFolder": "uploads"
  },
  "YandexOcr": {
    "ApiKey": "",
    "FolderId": "",
    "Endpoint": "https://ocr.api.cloud.yandex.net/ocr/v1/recognizeText",
    "Model": "handwritten",
    "LanguageCodes": [ "ru", "en" ]
  },
  "WordVectorization": {
    "PaddingPx": 4,
    "ApproximationTolerance": 1.5
  },
  "ScanList": {
    "PageSize": 30
  }
}
